{
  "expo": {
    "name": "Nitro Mapbox AR",
    "slug": "nitro-mapbox-ar-reference",
    "scheme": "nitro-mapbox-ar",
    "version": "0.0.1",
    "orientation": "default",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-horizon-core",
        {
          "supportedDevices": "quest2|questpro|quest3|quest3s|vrglasses",
          "defaultWidth": "1280dp",
          "defaultHeight": "800dp"
        }
      ],
      [
        "expo-horizon-location",
        {
          "locationWhenInUsePermission": "Location powers Mapbox search, routing and geospatial AR."
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": [
              "AR",
              "QUEST"
            ],
            "questSupportedDevices": "quest2|questpro|quest3|quest3s|vrglasses"
          }
        }
      ],
      "@reactvision/react-viro/plugins/withViroVisionOS",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/withMetaVR"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AR uses the camera to place Mapbox content in the world.",
        "NSLocationWhenInUseUsageDescription": "Location powers Mapbox search, routing and geospatial AR."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
