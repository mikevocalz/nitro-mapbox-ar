{
  "name": "@mikevocalz/nitro-mapbox-ar",
  "version": "0.0.1",
  "description": "Graphite-first spatial Mapbox terrain and AR primitives for React Native",
  "main": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run test:cpp",
    "check:gpu-stack": "node scripts/check-gpu-stack.mjs",
    "test": "npx --yes tsx@4.23.15 --test tests/**/*.test.ts",
    "test:cpp": "c++ -std=c++20 -Wall -Wextra -Werror -Icpp tests/terrain-rgb-codec.cpp -o /tmp/terrain-rgb-codec && /tmp/terrain-rgb-codec",
    "codegen:native-map": "npm run codegen --workspace @mikevocalz/nitro-mapbox-ar-maps",
    "typecheck:native-map": "npm run typecheck --workspace @mikevocalz/nitro-mapbox-ar-maps",
    "typecheck:reactvision": "npm run typecheck --workspace @mikevocalz/nitro-mapbox-ar-reactvision",
    "check:package-surface": "node scripts/check-package-surface.mjs",
    "typecheck:agent-mcp": "npm run typecheck --workspace @mikevocalz/nitro-mapbox-ar-agent-mcp",
    "check:web-surface": "node scripts/check-web-surface.mjs",
    "check:all": "npm run typecheck && npm run typecheck:api-sketch && npm test && npm run test:cpp && npm run typecheck:native-map && npm run typecheck:reactvision && npm run typecheck:agent-mcp && npm run typecheck:navigation && npm run typecheck:specs && npm run build && npm run check:core-imports && npm run typecheck:specs-lens && npm run check:package-surface && npm run check:web-surface && npm run lint && npm run check:nitrogen && npm run check:pack && npm run docs",
    "lint": "tooling/lint/node_modules/.bin/eslint .",
    "docs": "tooling/docs/node_modules/.bin/typedoc",
    "tooling:install": "npm ci --prefix tooling/lint --no-audit --no-fund && npm ci --prefix tooling/docs --no-audit --no-fund",
    "check:nitrogen": "node scripts/check-nitrogen.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "build": "bob build",
    "check:core-imports": "node scripts/check-core-imports.mjs",
    "typecheck:specs": "npm run typecheck --workspace @mikevocalz/nitro-mapbox-ar-specs",
    "typecheck:specs-lens": "tsc -p examples/specs-lens/tsconfig.json",
    "prepack": "bob build",
    "typecheck:navigation": "npm run typecheck --workspace @mikevocalz/nitro-mapbox-ar-navigation",
    "typecheck:api-sketch": "tsc --noEmit -p tests/api-sketch/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/nitro-mapbox-ar.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.12.0-0",
    "react": ">=19.0.0",
    "react-native": ">=0.86.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": ">=4.2.1",
    "react-native-webgpu": ">=0.13.0",
    "react-native-worklets": ">=0.7.2",
    "typegpu": "^0.12.7"
  },
  "author": "Mike W. Allen (https://github.com/mikevocalz)",
  "license": "MIT",
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "react-native-builder-bob": "0.43.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-webgpu": "0.13.0",
    "typegpu": "0.12.7",
    "typescript": "7.0.2",
    "unplugin-typegpu": "0.12.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist/module",
    "dist/typescript",
    "cpp",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "ios/Nitro",
    "NitroMapboxAR.podspec",
    "react-native.config.js",
    "scripts/check-gpu-stack.mjs",
    "scripts/check-package-surface.mjs",
    "docs",
    "README.md",
    "LICENSE",
    "skills",
    "nitro.json",
    "nitrogen/generated"
  ],
  "browser": "src/index.web.ts",
  "exports": {
    ".": {
      "browser": "./src/index.web.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./navigation": {
      "types": "./src/navigation/client.ts",
      "default": "./src/navigation/client.ts"
    },
    "./mapbox": {
      "types": "./src/mapbox/index.ts",
      "default": "./src/mapbox/index.ts"
    },
    "./core": {
      "types": "./dist/typescript/core/index.d.ts",
      "import": "./dist/module/core/index.js",
      "default": "./dist/module/core/index.js"
    }
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-webgpu": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "homepage": "https://github.com/mikevocalz/nitro-mapbox-ar#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/nitro-mapbox-ar/issues"
  },
  "funding": "https://github.com/sponsors/mikevocalz",
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
