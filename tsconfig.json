{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "paths": {
      "@mikevocalz/nitro-mapbox-ar/core": [
        "./src/core/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
